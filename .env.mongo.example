# Copy these keys to the ignored local .env. Never commit the real URI.
MONGO_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_DB_NAME=game_media_lab6
MONGO_PORT=3002
# Reuse the local JWT_SECRET or provide a separate random secret here.
JWT_SECRET=replace-with-a-long-random-local-secret
