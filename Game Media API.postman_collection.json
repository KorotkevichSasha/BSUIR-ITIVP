{
  "info": {
    "name": "Lab 1 - Game Media API",
    "description": "Минимальная коллекция для демонстрации CRUD-операций лабораторной работы.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get all posts",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:3001/posts"
      }
    },
    {
      "name": "2. Get post by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:3001/posts/1"
      }
    },
    {
      "name": "3. Create post",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Boss fight\",\n  \"game\": \"Elden Ring\",\n  \"mediaType\": \"video\",\n  \"mediaUrl\": \"https://example.com/boss-fight.mp4\",\n  \"description\": \"A short video from the boss fight.\",\n  \"comments\": [\"Well played!\"]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://localhost:3001/posts"
      }
    },
    {
      "name": "4. Update post",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Boss fight - no damage\",\n  \"game\": \"Elden Ring\",\n  \"mediaType\": \"video\",\n  \"mediaUrl\": \"https://example.com/boss-fight-no-damage.mp4\",\n  \"description\": \"The boss was defeated without taking damage.\",\n  \"comments\": [\"Impressive!\", \"Great timing!\"]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://localhost:3001/posts/3"
      }
    },
    {
      "name": "5. Delete post",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "http://localhost:3001/posts/3"
      }
    },
    {
      "name": "6. Check 404 after delete",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:3001/posts/3"
      }
    },
    {
      "name": "7. Check validation error",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Invalid post\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://localhost:3001/posts"
      }
    }
  ]
}
