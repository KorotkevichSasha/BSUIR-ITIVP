### Check that the server is running
GET http://localhost:3001/

### Get all posts
GET http://localhost:3001/posts

### Get one post
GET http://localhost:3001/posts/1

### Filter posts by media type
GET http://localhost:3001/posts?mediaType=video

### Create a post
POST http://localhost:3001/posts
Content-Type: application/json

{
  "title": "Boss fight",
  "game": "Elden Ring",
  "mediaType": "video",
  "mediaUrl": "/media/winning-goal.mp4",
  "description": "A short video from the boss fight.",
  "comments": ["Well played!"],
  "likesCount": 3
}

### Fully update the created post
PUT http://localhost:3001/posts/3
Content-Type: application/json

{
  "title": "Boss fight - no damage",
  "game": "Elden Ring",
  "mediaType": "video",
  "mediaUrl": "/media/winning-goal.mp4",
  "description": "The boss was defeated without taking damage.",
  "comments": ["Impressive!", "Great timing!"],
  "likesCount": 8
}

### Delete the created post
DELETE http://localhost:3001/posts/3

### Check the 404 response after deletion
GET http://localhost:3001/posts/3

### Check validation (400)
POST http://localhost:3001/posts
Content-Type: application/json

{
  "title": "Invalid post"
}

### Register (201; repeat the email for 409)
POST http://localhost:3001/auth/register
Content-Type: application/json

{
  "email": "student@example.com",
  "password": "Lab3-test-2026!"
}

### Login and copy token from the response
POST http://localhost:3001/auth/login
Content-Type: application/json

{
  "email": "student@example.com",
  "password": "Lab3-test-2026!"
}

### Replace the placeholder with the token from login
@token = paste_token_here

### Current user (200)
GET http://localhost:3001/profile
Authorization: Bearer {{token}}

### No token (401)
GET http://localhost:3001/profile

### Admin only (403 for user; 200 for admin)
GET http://localhost:3001/admin
Authorization: Bearer {{token}}
