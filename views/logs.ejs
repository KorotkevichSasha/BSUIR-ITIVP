<%- include('partials/header') %>
<h1><%= title %></h1>
<p class="intro">Последние 100 записей из таблицы RequestLogs в PostgreSQL. Вариант 13: логирование в БД.</p>
<p>Запрос сохраняется до вызова обработчика. Код ответа и длительность обновляются после его завершения. Для новых данных обновите страницу.</p>
<div class="table-wrap">
  <table>
    <thead>
      <tr><th>Время запроса</th><th>Метод</th><th>URL</th><th>Код ответа</th><th>Время, мс</th></tr>
    </thead>
    <tbody>
      <% logs.forEach((log) => { %>
        <tr>
          <td><%= new Date(log.requestedAt).toLocaleString('ru-RU', { timeZone: 'Europe/Minsk' }) %></td>
          <td><%= log.method %></td>
          <td class="url"><%= log.url %></td>
          <td><%= log.statusCode || 'В обработке' %></td>
          <td><%= log.statusCode ? Math.round(log.durationMs) : '—' %></td>
        </tr>
      <% }) %>
      <% if (logs.length === 0) { %>
        <tr><td colspan="5">В журнале пока нет записей.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('partials/footer') %>
