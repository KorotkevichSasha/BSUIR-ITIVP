<%- include('partials/header') %>
<h1><%= title %></h1>
<p class="intro">Последние 100 записей из файла logs/requests.log. Вариант 13: логирование в файл.</p>
<p>Каждый запрос сохраняется до вызова обработчика. Для новых записей обновите страницу.</p>
<div class="table-wrap">
  <table>
    <thead>
      <tr><th>Время запроса</th><th>Метод</th><th>URL</th></tr>
    </thead>
    <tbody>
      <% logs.forEach((log) => { %>
        <tr>
          <td><%= new Date(log.requestedAt).toLocaleString('ru-RU', { timeZone: 'Europe/Minsk' }) %></td>
          <td><%= log.method %></td>
          <td class="url"><%= log.url %></td>
        </tr>
      <% }) %>
      <% if (logs.length === 0) { %>
        <tr><td colspan="3">В журнале пока нет записей.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('partials/footer') %>
