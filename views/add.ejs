<%- include('partials/header') %>
<h1><%= title %></h1>
<p>Пользователь: <strong><%= user.name %></strong></p>
<% if (errors.length) { %>
  <div class="error" role="alert"><strong>Проверьте введённые данные:</strong>
    <ul><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul>
  </div>
<% } %>
<form class="card form" method="post" action="/add?auth=1">
  <label for="title">Название</label>
  <input id="title" name="title" required maxlength="<%= limits.title.maxLength %>" value="<%= values.title || '' %>">

  <label for="game">Игра</label>
  <input id="game" name="game" required maxlength="<%= limits.game.maxLength %>" value="<%= values.game || '' %>">

  <label for="mediaType">Тип медиа</label>
  <select id="mediaType" name="mediaType">
    <option value="screenshot" <%= values.mediaType === 'screenshot' ? 'selected' : '' %>>Скриншот</option>
    <option value="video" <%= values.mediaType === 'video' ? 'selected' : '' %>>Видео</option>
  </select>

  <label for="mediaUrl">Ссылка на медиа</label>
  <input id="mediaUrl" name="mediaUrl" required maxlength="<%= limits.mediaUrl.maxLength %>" placeholder="https://..." value="<%= values.mediaUrl || '' %>">

  <label for="likesCount">Количество лайков</label>
  <input id="likesCount" name="likesCount" type="text" inputmode="numeric" required maxlength="<%= limits.likesCount.maxLength %>" value="<%= values.likesCount %>">
  <small>Не более <%= limits.likesCount.maxLength %> цифр. Целое неотрицательное число.</small>

  <label for="description">Описание</label>
  <textarea id="description" name="description" rows="3" required maxlength="<%= limits.description.maxLength %>"><%= values.description || '' %></textarea>
  <small>Название — до <%= limits.title.maxLength %>, игра — до <%= limits.game.maxLength %>, описание — до <%= limits.description.maxLength %> символов. Поля из пробелов не принимаются.</small>

  <button type="submit">Опубликовать</button>
</form>
<script src="/form.js" defer></script>
<%- include('partials/footer') %>
