<%- include('partials/header') %>
<a href="/">← Все публикации</a>
<article class="card detail">
  <p class="badge"><%= item.mediaType === 'video' ? 'Видео' : 'Скриншот' %></p>
  <h1><%= item.title %></h1>
  <p class="game">Игра: <%= item.game %></p>
  <p>Лайков: <%= item.likesCount %></p>
  <p>Время создания: <%= formatDate(item.createdAt) %> · ID <%= item.id %></p>
  <p class="description"><%= item.description %></p>
  <% if (/^(https?:\/\/|\/media\/[a-z0-9-]+\.(svg|mp4)$)/i.test(item.mediaUrl)) { %>
    <a href="<%= item.mediaUrl %>" target="_blank" rel="noopener noreferrer">Открыть медиа ↗</a>
  <% } else { %>
    <p>Адрес медиа: <%= item.mediaUrl %></p>
  <% } %>
</article>
<%- include('partials/footer') %>
